---
import type { LibraryCatalog } from '@/lib/catalog';

interface Props {
  catalog: LibraryCatalog;
  activeDiscipline?: string;
  activeDomain?: string;
}
const { catalog, activeDiscipline, activeDomain } = Astro.props;
---
<aside class="catalog-sidebar">
  <section>
    <h2 class="nav-label">知识地图</h2>
    <nav class="catalog-domain-nav taxonomy-nav" aria-label="学科与知识领域">
      {catalog.disciplines.map((discipline) => {
        const expanded = discipline.slug === activeDiscipline || discipline.domains.some((domain) => domain.key === activeDomain);
        return <div class="taxonomy-group">
          <a class="discipline-link" href={discipline.href} aria-current={discipline.slug === activeDiscipline && !activeDomain ? 'page' : undefined}>
            <span>{expanded ? '▾' : '▸'} {discipline.label}</span><small>{discipline.courseCount}</small>
          </a>
          {expanded && <div class="taxonomy-children">{discipline.domains.map((domain) => (
            <a href={domain.href} aria-current={domain.key === activeDomain ? 'page' : undefined}>
              <span>{domain.label}</span><small>{domain.courseCount}</small>
            </a>
          ))}</div>}
        </div>;
      })}
    </nav>
  </section>
  <section class="catalog-filter-section">
    <h2 class="nav-label">馆藏</h2>
    <p><span>中文讲义</span><strong>{catalog.totalNotes}</strong></p>
    <p><span>课程</span><strong>{catalog.totalCourses}</strong></p>
    <p><span>学科 / 领域</span><strong>{catalog.disciplines.length} / {catalog.domains.length}</strong></p>
  </section>
  <section class="catalog-filter-section">
    <h2 class="nav-label">REAL TAGS · {catalog.tags.length}</h2>
    {catalog.tags.length ? <div class="catalog-tags">{catalog.tags.slice(0, 6).map((tag) => <span>{tag}</span>)}{catalog.tags.length > 6 && <span class="tag-overflow">+{catalog.tags.length - 6}</span>}</div> : <p class="catalog-empty">frontmatter 暂无可汇总 tags。</p>}
  </section>
</aside>
