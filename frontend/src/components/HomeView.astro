---
import AtlasLayout from '@/layouts/AtlasLayout.astro';
import CatalogSidebar from '@/components/CatalogSidebar.astro';
import type { LibraryCatalog } from '@/lib/catalog';

interface Props { catalog: LibraryCatalog }
const { catalog } = Astro.props;
---
<AtlasLayout title="Archipelago 知识群岛" description="按学科、领域与课程组织的公开课中文知识库。">
  <div class="atlas-shell">
    <CatalogSidebar catalog={catalog} />
    <div class="atlas-main">
      <header class="atlas-hero atlas-hero-home">
        <p class="atlas-kicker">ARCHIPELAGO · 群岛</p>
        <h1>知识群岛</h1>
        <p>从学科进入领域，再沿课程与阅读顺序探索彼此关联的长期知识库。</p>
        <div class="atlas-stats">{catalog.disciplines.length} 个学科 · {catalog.domains.length} 个领域 · {catalog.totalCourses} 门课程 · {catalog.totalNotes} 篇真实笔记</div>
      </header>

      <section class="atlas-section" aria-labelledby="disciplines-heading">
        <div class="atlas-section-head"><h2 id="disciplines-heading">学科群岛</h2><span>按真实目录与课程索引生成</span></div>
        <div class="discipline-grid">
          {catalog.disciplines.map((discipline, index) => (
            <a class="discipline-card" href={discipline.href}>
              <div class="domain-title"><span>{String(index + 1).padStart(2, '0')}</span><h3>{discipline.label}</h3></div>
              <p>{discipline.description}</p>
              <div class="discipline-categories">{discipline.domains.slice(0, 4).map((domain) => <span>{domain.label}</span>)}</div>
              <small>{discipline.domains.length} 个领域 · {discipline.courseCount} 门课程 · {discipline.noteCount} 篇笔记</small>
            </a>
          ))}
        </div>
      </section>

      <div class="atlas-lower-grid">
        <section class="atlas-section">
          <div class="atlas-section-head"><h2>RECENTLY UPDATED</h2><span>来自 Git 历史</span></div>
          <div class="recent-list">
            {catalog.recent.length ? catalog.recent.map((note) => (
              <a href={note.href}>
                <time datetime={note.updated}>{note.updated}</time>
                <span>{note.title}</span>
                <small>{note.course}</small>
              </a>
            )) : <p class="catalog-empty">Git 历史中暂无可用更新时间。</p>}
          </div>
        </section>
        <section class="atlas-section">
          <div class="atlas-section-head"><h2>COURSE ENTRY POINTS</h2><span>每个领域的真实课程入口</span></div>
          <div class="entry-list">
            {catalog.domains.map((domain) => (
              <div>
                <strong>{catalog.disciplines.find((item) => item.slug === domain.disciplineSlug)?.label} · {domain.label}</strong>
                {domain.courses.length ? <a href={domain.courses[0].href}>{domain.courses[0].courseId || domain.courses[0].title} →</a> : <span>暂无已收录课程</span>}
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</AtlasLayout>
